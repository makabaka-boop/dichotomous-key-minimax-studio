{
  "name": "dichotomous-key-minimax-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive dichotomous key editor with a minimax decision-tree solver (Lit + TypeScript).",
  "scripts": {
